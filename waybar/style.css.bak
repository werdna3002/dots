
* {
    font-family: "JetBrainsMono Nerd Font","DejaVu Sans", sans-serif;
    font-size: 13px;
    min-height: 0;
    border: none;
    border-radius: 0;
}

window#waybar {
    background: transparent;
    color: #cdd6f4;
}

/* Shared Catppuccin Mocha pills */
#workspaces,
#window,
#clock,
#network,
#pulseaudio,
#battery,
#tray,
#cpu,
#memory,
#custom-media,
#scratchpad,
#mode {
    background: #313244;
    color: #cdd6f4;
    border-radius: 18px;
    padding: 2px 10px;
    margin: 5px 4px;
}

/* Workspaces */
#workspaces {
    padding: 3px 5px;
}

#workspaces button {
    color: #a6adc8;
    background: transparent;
    border-radius: 14px;
    padding: 2px 9px;
    margin: 1px 2px;
}

#workspaces button.focused {
    background: #cba6f7;
    color: #1e1e2e;
}

#workspaces button:hover {
    background: #45475a;
    color: #cdd6f4;
    box-shadow: none;
}

/* Window title */
#window {
    background: transparent;
    color: #bac2de;
}

/* System monitors */
#cpu {
    color: #89b4fa;
}

#memory {
    color: #cba6f7;
}

/* Network and audio */
#network {
    color: #89dceb;
}

#network.disconnected {
    color: #f38ba8;
}

#pulseaudio {
    font-family: "JetBrainsMono Nerd Font";
    color: #f5c2e7;
}

#pulseaudio.muted {
    font-family: "JetBrainsMono Nerd Font";
    color: #f38ba8;
}

/* Battery */
#battery {
    color: #a6e3a1;
}

#battery.warning {
    color: #f9e2af;
}

#battery.critical {
    color: #f38ba8;
}

/* Clock */
#clock {
    color: #cba6f7;
    font-weight: bold;
}

/* Media player */
#custom-media {
    color: #a6e3a1;
}

#custom-media.custom-spotify {
    color: #a6e3a1;
}

#custom-media.custom-vlc {
    color: #fab387;
}
/* Power menu */
#custom-power {
    background: #45475a;
    color: #f38ba8;
    border-radius: 18px;
    padding: 2px 12px;
    margin: 5px 4px;
    min-width: 20px;
}

#custom-power:hover {
    background: #585b70;
    color: #fab387;
}

/* Tray */
#tray {
    padding: 3px 10px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
}

/* Scratchpad and mode */
#scratchpad {
    color: #f9e2af;
}

#scratchpad.empty {
    background: transparent;
}

#mode {
    color: #f38ba8;
}

/* Tooltips */
tooltip {
    background: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 10px;
}

tooltip label {
    color: #cdd6f4;
}
#custom-vibepanel {
    color: #cba6f7;
    padding: 0 10px;
    margin: 4px;
    border-radius: 10px;
}
#custom-cava {
    color: #cba6f7;
    font-family: monospace;
    font-size: 16px;
    padding: 0 8px;
}

